# The declared Node floor (engines >= 22.13, set by the Cursor SDK) is
# ENFORCED, not advisory: installs on an unsupported Node fail here instead
# of warning and then crashing at runtime. The self-updater's rebuild runs
# npm ci in this tree, so an update attempted on an old Node fails cleanly
# and rolls back rather than relaunching a broken checkout.
engine-strict=true
