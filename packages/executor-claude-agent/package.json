{
  "name": "@brainstorm-agentic/executor-claude-agent",
  "version": "0.1.0",
  "description": "Claude Agent SDK AgentExecutor authenticated with a claude setup-token token.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.217",
    "@brainstorm-agentic/credit-recovery": "0.1.0",
    "@brainstorm-agentic/core": "0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
