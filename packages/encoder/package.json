{
  "name": "@brainstorm-agentic/encoder",
  "version": "0.1.0",
  "description": "Pinned text encoders (local ONNX SPECTER2 / bge-base-en-v1.5, OpenRouter embeddings, hash-ngram-v1) and the cached taxonomy node-vector index.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@brainstorm-agentic/core": "0.1.0",
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
